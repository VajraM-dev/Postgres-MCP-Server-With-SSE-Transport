# Database Connection Configuration
# -----------------------------
# PostgreSQL database credentials and connection parameters
POSTGRES_USERNAME =     # PostgreSQL username for database authentication
POSTGRES_PASSWORD =     # PostgreSQL password for database authentication
POSTGRES_DB_NAME =      # Name of the PostgreSQL database to connect to
POSTGRES_HOST =         # Database host (localhost, IP address, or domain)
POSTGRES_PORT =         # PostgreSQL server port (default is usually 5432)

# MCP (Message Control Protocol) Server Configuration
# --------------------------------------------------
# Server identifier and basic network configuration
MCP_NAME = "Postgres MCP"     # Descriptive name for the MCP server instance
MCP_HOST = localhost           # Host address for the MCP server
MCP_PORT = 5000               # Port number for the MCP server to listen on

# Transport Configuration
# ----------------------
# Defines the communication method for the MCP server
TRANSPORT = sse  # Transport protocol options:
                 # - stdio: Standard input/output communication
                 # - sse: Server-Sent Events (recommended for web-based communication)

# Full URL for Server-Sent Events (SSE) endpoint
# Uses interpolation to create the full URL based on host and port
MCP_SERVER_URL = "http://${MCP_HOST}:${MCP_PORT}/sse"

# AI Provider API Credentials
# --------------------------
# API keys for different AI service providers
ANTHROPIC_API_KEY =     # API key for Anthropic services
GOOGLE_API_KEY =        # API key for Google AI services

# AI Model Configuration
# ---------------------
# Specific AI models to use from different providers
ANTHROPIC_MODEL = claude-3-5-haiku-latest  # Anthropic's latest Haiku model
GOOGLE_MODEL = gemini-2.0-flash-lite       # Google's lightweight flash model

# AI Provider Selection
# --------------------
USE_PROVIDER = "anthropic"  # Determines which AI provider to use
                             # Options:
                             # - anthropic: Use Anthropic's AI services
                             # - google: Use Google's AI services

